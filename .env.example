# === Telegram Bot ===
TELEGRAM_BOT_TOKEN=your_bot_token_here

# === LLM-провайдер ===
# Допустимые значения: yandex | openai | ollama | stub | auto
# auto - автоматический выбор (yandex → openai → ollama → stub)
# stub - демо-режим без API-ключей
LLM_PROVIDER=auto

# === Демо-режим ===
# Включить демо-режим (работает без API-ключей)
# По умолчанию включен, если не заданы ключи LLM
DEMO_MODE=true

# === YandexGPT ===
# Получить: https://console.yandex.cloud/ →
#   сервисный аккаунт с ролью ai.languageModels.user →
#   создать API-ключ.
# FOLDER_ID каталога — на странице каталога.
YANDEX_GPT_API_KEY=AQVN_yandex_api_key_placeholder
YANDEX_GPT_FOLDER_ID=b1g_folder_id_placeholder

# === OpenAI-совместимый провайдер ===
# Используется, если LLM_PROVIDER=openai.
# Для локальных моделей (LM Studio, Ollama) дополнительно задайте OPENAI_BASE_URL.
OPENAI_API_KEY=sk-your_openai_api_key_here
# OPENAI_BASE_URL=http://localhost:11434/v1

# === Ollama (специализированная поддержка) ===
# Используется, если LLM_PROVIDER=ollama.
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5-coder:32b-instruct

# === Параметры LLM (общие для всех провайдеров) ===
LLM_MODEL=yandexgpt-lite
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=800
LLM_TIMEOUT=120  # Таймаут в секундах (особенно важно для локальных моделей)# === Параметры эмбеддингов ===
EMBEDDING_MODEL=all-MiniLM-L6-v2

# === Параметры поиска ===
SIMILARITY_THRESHOLD=0.45
SEARCH_K_RESULTS=8

# === Безопасность ===
SECURITY_ENABLED=true

# === Пути к файлам ===
KNOWLEDGE_INDEX=faiss.index
INDEX_METADATA=index_metadata.pkl
INDEX_CHUNKS=index_chunks.pkl
